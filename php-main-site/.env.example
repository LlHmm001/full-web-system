# php-main-site 环境配置
# 复制此文件为 .env 并修改实际值
#
# 注意：table-importer 项目也需要相同的 MYSQL_ROOT_PASSWORD，
# 部署时请确保两边 .env 的密码一致。

# 应用端口（对外暴露）
APP_HOST_PORT=3001

# MySQL 配置
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=mydb
# 以下为 MySQL 首次初始化时自动创建的应用用户（目前未使用）
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_user_password

# 时区
TZ=Asia/Shanghai
