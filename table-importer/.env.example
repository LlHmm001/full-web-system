# App
APP_HOST_PORT=3003
APP_CONTAINER_PORT=3003

# Target database: php-main-site MySQL container on apps_shared_network.
# DB_PASSWORD must match php-main-site's MYSQL_ROOT_PASSWORD.
# Copy this file to .env on the server and edit values there.
DB_HOST=php_main_site_mysql
DB_PORT=3306
DB_NAME=mydb
DB_USER=root
DB_PASSWORD=change_me

# Optional full URL override. Leave empty to build from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
MYSQL_DATABASE_URL=
